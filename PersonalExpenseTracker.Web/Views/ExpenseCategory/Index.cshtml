@model IEnumerable<PersonalExpenseTracker.Service.DTOs.CategoryDto>

@{
    ViewData["Title"] = "Categories";
}
@if (TempData["Success"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Success',
            text: '@TempData["Success"]',
            confirmButtonColor: '#198754'
        });
    </script>
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="top-section mb-4">
        <h2 class="page-title">
            <i class="fa-solid fa-layer-group text-primary me-2"></i>
            Expense Categories
        </h2>

        <a class="btn btn-primary btn-custom shadow-sm"
           asp-action="Create">
            <i class="fa-solid fa-plus me-2"></i>
            Add Category
        </a>
    </div>

    <!-- Category Table -->
    <div class="card custom-card">

        <div class="card-body table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th>
                            <i class="fa-solid fa-folder-open me-1"></i>
                            Name
                        </th>

                        <th>
                            <i class="fa-solid fa-align-left me-1"></i>
                            Description
                        </th>

                        <th class="text-center">
                            <i class="fa-solid fa-gear me-1"></i>
                            Action
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <span class="category-badge">
                                        @item.Name
                                    </span>
                                </td>

                                <td class="description-text">
                                    @(string.IsNullOrWhiteSpace(item.Description)
                                                                ? "No description available"
                                                                : item.Description)
                        </td>

                                <td class="text-center">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm btn-custom me-1">

                                        <i class="fa-solid fa-pen-to-square me-1"></i>
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm btn-custom">

                                        <i class="fa-solid fa-trash me-1"></i>
                                        Delete
                                    </a>

                                </td>

                            </tr>
                                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="empty-data">
                                <i class="fa-solid fa-folder-open fa-2x mb-3 d-block text-secondary"></i>
                                No categories found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>