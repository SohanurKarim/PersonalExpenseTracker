@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->
<div class="hero-banner text-white d-flex align-items-center">

    <div class="container text-center">

        <h1 class="fw-bold display-5 mb-3">
            <i class="fa-solid fa-wallet me-2"></i>
            Personal Expense Tracker
        </h1>

        <p class="lead opacity-75 mb-4">
            Track expenses, manage categories and improve your financial habits
        </p>

        <a asp-controller="Expense" asp-action="Create"
           class="btn btn-success btn-lg rounded-3 px-4 me-2">

            <i class="fa-solid fa-plus me-1"></i>
            Add Expense
        </a>

        <a asp-controller="Expense" asp-action="Index"
           class="btn btn-outline-light btn-lg rounded-3 px-4">

            View Expenses
        </a>

    </div>

</div>

<!-- INTRO SECTION -->
<div class="container py-5">

    <div class="row align-items-center g-5">

        <div class="col-lg-6">

            <h2 class="fw-bold mb-3">
                Take Control of Your Money
            </h2>

            <p class="text-muted">
                A simple and modern way to track your daily expenses and understand your spending habits.
            </p>

            <ul class="list-unstyled mt-4">

                <li class="mb-2">
                    <i class="fa-solid fa-circle-check text-success me-2"></i>
                    Easy expense tracking
                </li>

                <li class="mb-2">
                    <i class="fa-solid fa-circle-check text-success me-2"></i>
                    Smart category management
                </li>

                <li class="mb-2">
                    <i class="fa-solid fa-circle-check text-success me-2"></i>
                    Clear financial insights
                </li>

            </ul>

            <a asp-controller="Expense" asp-action="Index"
               class="btn btn-primary mt-3 px-4 rounded-3">
                Start Now
            </a>

        </div>

        <div class="col-lg-6">

            <div class="rounded-4 overflow-hidden shadow-sm">
                <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1200&q=80"
                     class="img-fluid rounded-4 shadow-sm" />

            </div>

        </div>

    </div>

</div>

<!-- TESTIMONIALS -->
<div class="container pb-5">

    <div class="text-center mb-4">

        <h3 class="fw-bold">What Users Say</h3>
        <p class="text-muted">Simple and effective expense tracking</p>

    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <p class="text-muted">
                    “Helps me track my daily spending very easily.”
                </p>
                <div class="d-flex align-items-center mt-3">
                    <i class="fa-solid fa-user-circle fs-2 text-primary me-2"></i>
                    <div>
                        <strong>Rahim</strong><br />
                        <small class="text-muted">Student</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <p class="text-muted">
                    “Clean UI and very smooth experience.”
                </p>
                <div class="d-flex align-items-center mt-3">
                    <i class="fa-solid fa-user-circle fs-2 text-success me-2"></i>
                    <div>
                        <strong>Ayesha</strong><br />
                        <small class="text-muted">Developer</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <p class="text-muted">
                    “Now I understand my monthly expenses clearly.”
                </p>
                <div class="d-flex align-items-center mt-3">
                    <i class="fa-solid fa-user-circle fs-2 text-warning me-2"></i>
                    <div>
                        <strong>Karim</strong><br />
                        <small class="text-muted">Business Owner</small>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

<!-- STYLE -->
<style>
    .hero-banner {
        height: 420px;
        background: linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.55)), url('https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?auto=format&fit=crop&w=1600&q=80');
        background-size: cover;
        background-position: center;
    }

    .card:hover {
        transform: translateY(-3px);
        transition: 0.3s ease;
    }
</style>