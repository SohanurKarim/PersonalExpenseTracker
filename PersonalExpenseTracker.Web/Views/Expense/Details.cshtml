@model PersonalExpenseTracker.Service.DTOs.ExpenseDto

@{
    ViewData["Title"] = "Expense Details";
}



<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-6 col-md-8">

            <div class="card shadow border-0 rounded-4">

                <!-- Header -->
                <div class="card-header bg-primary text-white py-3 rounded-top-4">
                    <h3 class="mb-0 fw-bold">
                        <i class="fa-solid fa-receipt me-2"></i>
                        Expense Details
                    </h3>
                </div>

                <!-- Body -->
                <div class="card-body p-4">

                    <ul class="list-group list-group-flush">

                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                <i class="fa-solid fa-file-lines text-primary me-2"></i>
                                Title
                            </span>
                            <span class="fw-semibold">@Model.Title</span>
                        </li>

                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                <i class="fa-solid fa-money-bill-wave text-success me-2"></i>
                                Amount
                            </span>
                            <span class="fw-bold text-success">
                                ৳ @Model.Amount
                            </span>
                        </li>

                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                <i class="fa-regular fa-calendar text-warning me-2"></i>
                                Date
                            </span>
                            <span class="fw-semibold">
                                @Model.Date.ToString("dd MMM yyyy")
                            </span>
                        </li>

                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                <i class="fa-solid fa-layer-group text-info me-2"></i>
                                Category
                            </span>
                            <span class="badge bg-info text-dark px-3 py-2 rounded-pill">
                                @Model.CategoryName
                            </span>
                        </li>

                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                <i class="fa-solid fa-receipt text-secondary me-2"></i>
                                Receipt
                            </span>

                            @if (Model.HasReceipt)
                            {
                                <span class="badge bg-success">
                                    <i class="fa-solid fa-check me-1"></i> Available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    <i class="fa-solid fa-xmark me-1"></i> Not Available
                                </span>
                            }
                        </li>

                    </ul>

                </div>

                <!-- Footer -->
                <div class="card-footer bg-white border-0 text-end rounded-bottom-4">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary rounded-3 px-4">

                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Back
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>