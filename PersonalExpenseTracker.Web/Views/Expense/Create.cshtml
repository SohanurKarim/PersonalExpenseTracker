@model PersonalExpenseTracker.Web.ViewModels.Expense.ExpenseCreateVM

@{
    ViewData["Title"] = "Create Expense";
}


<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-7 col-md-9">

            <div class="card shadow border-0 rounded-4">

                <!-- Header -->
                <div class="card-header bg-success text-white py-3 rounded-top-4">
                    <h3 class="mb-0 fw-bold">
                        <i class="fa-solid fa-circle-plus me-2"></i>
                        Create Expense
                    </h3>
                </div>

                <!-- Body -->
                <div class="card-body p-4">

                    <form asp-action="Create" method="post" enctype="multipart/form-data">

                        <!-- Title -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold">
                                <i class="fa-solid fa-file-lines text-primary me-1"></i>
                                Title
                            </label>

                            <input asp-for="Title"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="Enter expense title" />

                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Amount -->
                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label fw-semibold">
                                <i class="fa-solid fa-money-bill-wave text-success me-1"></i>
                                Amount
                            </label>

                            <input asp-for="Amount"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="Enter amount" />

                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <!-- Date -->
                        <div class="mb-3">
                            <label asp-for="Date" class="form-label fw-semibold">
                                <i class="fa-regular fa-calendar text-warning me-1"></i>
                                Date
                            </label>

                            <input asp-for="Date"
                                   type="date"
                                   class="form-control rounded-3" />
                        </div>

                        <!-- Category -->
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label fw-semibold">
                                <i class="fa-solid fa-layer-group text-info me-1"></i>
                                Category
                            </label>

                            <select asp-for="CategoryId"
                                    class="form-select rounded-3"
                                    asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                                <option value="">-- Select Category --</option>
                            </select>
                        </div>

                        <!-- Notes -->
                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label fw-semibold">
                                <i class="fa-solid fa-note-sticky text-secondary me-1"></i>
                                Notes
                            </label>

                            <textarea asp-for="Notes"
                                      class="form-control rounded-3"
                                      rows="3"
                                      placeholder="Optional notes..."></textarea>
                        </div>

                        <!-- Receipt -->
                        <div class="mb-4">
                            <label asp-for="ReceiptFile" class="form-label fw-semibold">
                                <i class="fa-solid fa-receipt text-dark me-1"></i>
                                Receipt Upload
                            </label>

                            <input asp-for="ReceiptFile"
                                   type="file"
                                   class="form-control rounded-3" />
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between flex-wrap gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4 rounded-3">

                                <i class="fa-solid fa-arrow-left me-1"></i>
                                Back
                            </a>

                            <button type="submit"
                                    class="btn btn-success px-4 rounded-3 fw-semibold">

                                <i class="fa-solid fa-floppy-disk me-1"></i>
                                Save Expense
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}