@model PersonalExpenseTracker.Web.ViewModels.Expense.ExpenseEditVM

@{
    ViewData["Title"] = "Edit Expense";
}

@{
    var categories = ViewBag.Categories as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-7 col-md-9">

            <div class="card shadow border-0 rounded-4">

                <!-- Header -->
                <div class="card-header bg-warning text-dark py-3 rounded-top-4">
                    <h3 class="mb-0 fw-bold">
                        <i class="fa-solid fa-pen-to-square me-2"></i>
                        Edit Expense
                    </h3>
                </div>

                <!-- Body -->
                <div class="card-body p-4">

                    <form asp-action="Edit" method="post">

                        <input type="hidden" asp-for="Id" />

                        <!-- Title -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fa-solid fa-file-lines text-primary me-1"></i>
                                Title
                            </label>
                            <input asp-for="Title" class="form-control form-control-lg rounded-3" />
                        </div>

                        <!-- Amount -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fa-solid fa-money-bill-wave text-success me-1"></i>
                                Amount
                            </label>
                            <input asp-for="Amount" class="form-control form-control-lg rounded-3" />
                        </div>

                        <!-- Date -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fa-regular fa-calendar text-warning me-1"></i>
                                Date
                            </label>
                            <input asp-for="Date" type="date" class="form-control rounded-3" />
                        </div>

                        <!-- Category -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fa-solid fa-layer-group text-info me-1"></i>
                                Category
                            </label>

                            <select asp-for="CategoryId"
                                    class="form-select rounded-3"
                                    asp-items="@(new SelectList(categories, "Value", "Text", Model.CategoryId))">
                            </select>
                        </div>

                        <!-- Notes -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="fa-solid fa-note-sticky text-secondary me-1"></i>
                                Notes
                            </label>

                            <textarea asp-for="Notes"
                                      class="form-control rounded-3"
                                      rows="3"></textarea>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between flex-wrap gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4 rounded-3">

                                <i class="fa-solid fa-arrow-left me-1"></i>
                                Back
                            </a>

                            <button type="submit"
                                    class="btn btn-warning px-4 rounded-3 fw-semibold">

                                <i class="fa-solid fa-rotate me-1"></i>
                                Update Expense
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>